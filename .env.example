SUPABASE_URL=###
SUPABASE_KEY=###

# Garmin integration (S-01) — off-edge sidecar + password encryption key.
# GARMIN_SIDECAR_URL: public HTTPS URL of the Koyeb sidecar (e.g. https://xxx.koyeb.app)
# GARMIN_SIDECAR_SECRET: shared bearer secret the Worker sends to the sidecar (long random string)
# GARMIN_PASSWORD_ENC_KEY: server key used to AES-GCM encrypt the stored Garmin password
GARMIN_SIDECAR_URL=###
GARMIN_SIDECAR_SECRET=###
GARMIN_PASSWORD_ENC_KEY=###

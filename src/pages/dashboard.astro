---
import Layout from "@/layouts/Layout.astro";
import GarminSection from "@/components/garmin/GarminSection";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl py-8">
      <div class="mb-6 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div class="flex items-center justify-between">
          <div>
            <h1
              class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
            >
              Dashboard
            </h1>
            <p class="text-blue-100/80">
              Welcome, <span class="font-semibold text-white">{user?.email}</span>
            </p>
          </div>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>
      </div>

      <GarminSection client:load />
    </div>
  </div>
</Layout>
